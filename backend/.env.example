# App
APP_NAME=InterviewForge AI
APP_ENV=development
SECRET_KEY=your_super_secret_key_minimum_32_characters
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/interviewforge

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=interviewforge-assets
AWS_REGION=ap-south-1

# Redis (optional, for rate limiting & caching)
REDIS_URL=redis://localhost:6379
