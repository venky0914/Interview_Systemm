APP_NAME=InterviewForge AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-$(openssl rand -hex 32)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewforge
REDIS_URL=redis://localhost:6379

JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-$(openssl rand -hex 32)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GEMINI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=interviewforge-assets
AWS_REGION=ap-south-1
